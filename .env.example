# Copy to .env for local development. Never commit .env.
# Do not put a Gemini API key here. Firebase AI Logic does not use one in the client.

# Optional overrides. The committed web config is used when these are empty.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Free-tier text model. Billing is not required for this model on the Gemini Developer API.
VITE_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional override. The committed Enterprise site key is used when this is empty.
# Classic reCAPTCHA v3 is deprecated; leave the provider as enterprise.
VITE_APPCHECK_SITE_KEY=
VITE_APPCHECK_PROVIDER=

# Localhost only. Use `true` to let the SDK print a new debug token, or paste a
# token you already registered in Firebase console > App Check > Manage debug tokens.
# Production builds ignore this unless VITE_APPCHECK_ALLOW_DEBUG=true.
# Never commit a real token. Never ship a debug build to public hosting.
VITE_APPCHECK_DEBUG_TOKEN=
VITE_APPCHECK_ALLOW_DEBUG=

# Force local sample readings even when Firebase config is present.
VITE_FAHIM_PRACTICE=false
